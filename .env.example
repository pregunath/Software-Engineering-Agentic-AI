# Shared / local defaults
AGENT_ENVIRONMENT=development
AGENT_APP_NAME=Forge Software Engineer Agent
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_OLLAMA_MODEL=gemma4:e2b
AGENT_OLLAMA_TIMEOUT_SECONDS=30
AGENT_DATABASE_URL=sqlite:///./agent.db
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8000
AGENT_PUBLIC_BASE_URL=http://127.0.0.1:8000
AGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave empty in local development to keep the API open on localhost.
# Required when AGENT_ENVIRONMENT=production.
AGENT_API_KEY=

# Frontend (local)
# Browser calls the Next.js proxy; the proxy talks to the backend.
NEXT_PUBLIC_API_BASE_URL=/api/forge
FORGE_API_UPSTREAM=http://127.0.0.1:8000
FORGE_API_KEY=

# --- Cloud (Vercel + Fly.io) example ---
# AGENT_ENVIRONMENT=production
# AGENT_API_HOST=0.0.0.0
# AGENT_API_PORT=8000
# AGENT_PUBLIC_BASE_URL=https://forge-api.fly.dev
# AGENT_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# AGENT_API_KEY=replace-with-a-long-random-secret
# AGENT_OLLAMA_BASE_URL=http://forge-ollama.internal:11434
# AGENT_DATABASE_URL=sqlite:////data/agent.db
# FORGE_API_UPSTREAM=https://forge-api.fly.dev
# FORGE_API_KEY=replace-with-a-long-random-secret
# NEXT_PUBLIC_API_BASE_URL=/api/forge
